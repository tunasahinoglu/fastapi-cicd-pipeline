// CD/infra pipeline (terraform apply -> helm deploy -> destroy job)
pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Terraform: create the infrastructure (apply) or remove it completely (destroy)'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: "Image tag to deploy from ECR"
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION     = 'us-east-1'
        TF_DIR         = 'terraform/infra'
        CLUSTER_NAME   = 'fastapi-cicd-eks'
        ECR_REPO       = 'fastapi-cicd-pipeline'
        AWS_ACCOUNT_ID = credentials('aws-account-id')
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    dir(env.TF_DIR) {
                        sh 'terraform init -input=false'
                    }
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    dir(env.TF_DIR) {
                        sh 'terraform plan -out=tfplan -input=false'
                    }
                }
            }
        }

        stage('Manual Approval') {
            steps {
                script {
                    def message = (params.ACTION == 'apply')
                        ? "This will create the EKS cluster (hourly costs will start). Continue?"
                        : "EKS cluster and VPC will be PERMANENTLY DELETED. Continue?"
                    input message: message, ok: 'Confirm'
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    dir(env.TF_DIR) {
                        sh 'terraform apply -input=false tfplan'
                    }
                }
            }
        }

        stage('Configure kubectl') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh "aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}"
                }
            }
        }

        stage('Helm Deploy') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh """
                        helm upgrade --install fastapi-app helm/fastapi-app \
                          --set image.repository=${ECR_REGISTRY}/${ECR_REPO} \
                          --set image.tag=${params.IMAGE_TAG} \
                          --wait --timeout 5m
                    """
                }
            }
        }

        stage('Smoke Test') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh """
                        kubectl rollout status deployment/fastapi-app --timeout=120s
                        kubectl port-forward svc/fastapi-app 8000:80 &
                        PF_PID=\$!
                        sleep 5
                        curl -sf http://localhost:8000/health
                        kill \$PF_PID || true
                    """
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    dir(env.TF_DIR) {
                        sh 'terraform destroy -auto-approve -input=false'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (params.ACTION == 'apply') {
                    echo "EKS cluster is up and the application was deployed. After taking a demo/screenshot, don't forget to run this job again with ACTION=destroy to avoid costs."
                } else {
                    echo "Infrastructure was successfully removed. Images in ECR were not affected (stored in a separate state)."
                }
            }
        }
        failure {
            echo "Pipeline failed, check the console logs."
        }
    }
}